# CPU usage
#
# The script may be called with -w and -c switches to specify thresholds,
# see the script for details.
[cpu_usage]
label=CPU 
command=cpu_usage/cpu_usage
markup=pango
interval=10
min_width=CPU 100.0%
#separator=false

#[load_average]
#label=LOAD
#interval=10


# Temperature
#
# Support multiple chips, though lm-sensors.
# The script may be called with -w and -c switches to specify thresholds,
# see the script for details.
[temperature]
label=TEMP 
command=perl temperature
interval=10
color=#FFA500
# Battery indicator
#
# The battery instance defaults to 0.
[battery]
label=BAT
label=⚡
command=battery/battery
interval=30

